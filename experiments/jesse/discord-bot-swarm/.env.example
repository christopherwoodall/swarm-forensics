PUBLIC_ORIGIN=https://swarm.example.com
OIDC_ISSUER=https://identity.example.com/realms/swarm
OIDC_CLIENT_ID=discord-bot-swarm
OIDC_SCOPE=openid profile email
POSTGRES_PASSWORD=replace-with-a-random-application-database-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-different-random-administrator-password
# For running directly with npm (Compose supplies these):
# PORT=3000
# DATA_DIR=/absolute/private/swarm-data
# PGHOST=localhost
# PGUSER=swarm
# PGDATABASE=discord_bot_swarm
# PGPASSWORD=your-database-password
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
